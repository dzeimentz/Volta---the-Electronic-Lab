{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cmake --preset:*)",
      "Bash(cmake --build:*)",
      "Bash(ctest:*)",
      "Bash(python3 tools/validate_content.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(clang-format:*)",
      "Bash(lupdate:*)",
      "Bash(lrelease:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(rm:*)"
    ],
    "deny": [
      "Read(./packaging/**/*.keystore)",
      "Read(./packaging/**/*.jks)",
      "Read(./packaging/**/*.pfx)",
      "Read(./packaging/**/*.p12)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
